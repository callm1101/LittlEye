{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小眼睛",
  "version": "0.2.0",
  "identifier": "com.littleye.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "macOSPrivateApi": true, "windows": [{ "label": "main", "title": "小眼睛", "width": 340, "height": 420, "minWidth": 300, "minHeight": 300, "resizable": false, "decorations": false, "transparent": true, "alwaysOnTop": true }], "security": { "csp": null } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
